<div class="w-full flex flex-col items-center text-center px-5 gap-4 mt-20">
  <h1 class="text-5xl font-bold">
    Error: <span class="text-redColor">{{status}}</span>
  </h1>
  
  <h2 class="text-4xl font-bold">Oops! Something went wrong.</h2>

  <div class="w-full max-w-xl mx-auto bg-darkRedColor border border-redColor py-3 rounded-sm text-xl font-bold">
    {{errorMessage}}
  </div>
  
  <div class="w-full flex flex-col items-center mt-2.5 gap-4">
    <a
      href="/"
      class="p-3 border border-redColor font-bold   bg-darkRedColor" 
    >
      Back to home
    </a>
    <a
      href="/dashboard"
      class="p-3 border border-redColor font-bold   bg-darkRedColor">
      Back to dashboard
    </a>
  </div>
</div>
 