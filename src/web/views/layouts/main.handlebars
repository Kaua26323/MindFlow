<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <meta name="description" content="A platform designed to capture, organize, and share your flow of thoughts." />
  <meta name="keywords" content="thoughts, mindflow, notes, social network, MindFlow" />
  <meta name="author" content="Kauã Souza" />
  <meta name="theme-color" content="#121212" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content="https://mindflow-ohhi.onrender.com" />
  <meta property="og:site_name" content="MindFlow" />
  <meta property="og:title" content="MindFlow | Capture Your Thoughts" />
  <meta property="og:description" content="A platform designed to capture, organize, and share your flow of thoughts." />
  <meta property="og:image" content="https://mindflow-ohhi.onrender.com/favicon/android-chrome-512x512.png" />
  <meta property="og:image:alt" content="MindFlow" />

  <meta name="twitter:card" content="summary"/>
  <meta name="twitter:url" content="https://mindflow-ohhi.onrender.com" />
  <meta name="twitter:title" content="MindFlow | Capture Your Thoughts" />
  <meta name="twitter:description" content="A platform designed to capture, organize, and share your flow of thoughts." />
  <meta name="twitter:image" content="https://mindflow-ohhi.onrender.com/favicon/android-chrome-512x512.png"/>



  <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
  
  <link rel="manifest" href="/favicon/site.webmanifest" />

  <link rel="stylesheet" href="/css/output.css">
  <title>MindFlow</title>
</head>
<body class="w-full min-h-screen bg-background text-textDefault">
  <header class="sticky border-b border-b-accent top-0 z-50 w-full backdrop-blur-md mb-10">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a 
        href="/" 
        class="flex items-center gap-2 text-primary hover:text-accent hover:scale-110 transition-all duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain-icon lucide-brain"><path d="M12 18V5"/><path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4"/><path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"/><path d="M17.997 5.125a4 4 0 0 1 2.526 5.77"/><path d="M18 18a4 4 0 0 0 2-7.464"/><path d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"/><path d="M6 18a4 4 0 0 1-2-7.464"/><path d="M6.003 5.125a4 4 0 0 0-2.526 5.77"/></svg>
        <span class="font-bold text-xl tracking-wide sm:text-3xl">MindFlow</span>
      </a>

      <nav class="flex items-center gap-4">
        {{#if session.user}}
          <a
            href='/favorites'
            class="text-sm font-medium transition-colors hover:text-accent sm:text-xl"
          > 
            Favorites
          </a>
          <a
            href='/dashboard'
            class="text-sm font-medium transition-colors hover:text-accent sm:text-xl"
          > 
            Dashboard
          </a>
          <a
            href='/logOut'
            class="text-sm font-medium transition-colors hover:text-redColor sm:text-xl"
          > 
            LogOut
          </a>
        {{else}}
          <a
            href="/login"
            class="text-sm font-medium transition-colors hover:text-accent sm:text-xl">
            Login
          </a>
          <a
            href="/register"
            class="text-sm font-medium transition-colors hover:text-accent sm:text-xl"
          >
          Register
          </a>
        {{/if}}
      </nav>
    </div>
  </header>
  <div class="flex flex-col flex-1 pb-6">
    {{#if errors}}
      <div class="w-full max-w-xl mx-auto bg-darkRedColor border border-redColor py-3 text-center rounded my-3">
        {{errors}}
      </div>
    {{/if}}
    {{#if success}}
      <div class="w-full max-w-xl mx-auto bg-darkGreenColor border border-greenColor py-3 text-center rounded my-3">
        {{success}}
      </div>
    {{/if}}
    {{{body}}}
  </div>
</body>
</html>