<div class="w-full max-w-6xl mx-auto px-6 py-12">

  <div class="mb-10">
    <div class="flex items-center gap-3 mb-4">
      <div class="p-2 rounded-lg bg-primary/10 text-primary">
        {{> icons/heart}}
      </div>
      <h1 class="text-3xl font-bold">My Favorites</h1>
    </div>
  </div>

  <div class="space-y-6" id="favorites-container">
    {{#if favorites.length}}
      {{#each favorites}}
        <div class="favorite-item py-4 px-8 rounded-sm relative transition-all duration-300 border border-border bg-background2 group overflow-hidden">
          <div class="absolute top-0 left-0 w-1 h-full bg-primary"></div>
          
          <div class="flex justify-between items-start mb-1 text-specialText">
            {{> icons/message}}
            
            <div class="flex gap-2">
              <form action="/favorite/remove/{{this.post_id}}?_method=DELETE" method="POST">
                <input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
                <button
                  type="submit"
                  class="p-2 rounded-lg bg-background text-specialText hover:text-redColor hover:bg-redColor/10"
                  title="Remove from favorites"
                  aria-label="Remove from favorites"
                >
                  {{> icons/trash}}
                </button>
              </form>
            </div>
          </div>

          <p class="mb-1 text-xl leading-relaxed">
            "{{this.text}}"
          </p>

          <div class="flex items-center justify-between pt-4 border-t border-border">
            <div>
              <span class="text-specialText">{{formatDate this.createdAt}}</span>
            </div>
            <a 
              href="/" 
              class="flex items-center gap-1 text-sm text-specialText hover:text-white"
            >
              View on Home <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
            </a>
          </div>
        </div>
      {{/each}}
      {{> components/navigationBar pagination=pagination}}
    {{else}}
      <div class="text-center py-20 rounded-3xl border border-dashed border-border bg-background2/50">
        <div class="w-16 h-16 bg-background2 rounded-full flex items-center justify-center mx-auto mb-4 border border-border">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-specialText"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        </div>
        <h3 class="text-lg font-medium mb-2">Nothing here yet...</h3>
        <p class="text-specialText mb-6">You haven't favorited anything yet...</p>
        <a 
          href="/"
          class="bg-primary inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-bold"
        >
          Explore Posts
        </a>
      </div>
    {{/if}}
  </div>
</div>
