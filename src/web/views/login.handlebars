<div class="w-full max-w-6xl mx-auto flex items-center justify-center px-6 mt-8">
  <div class="w-full max-w-md animate-fade-in-up">
    <div 
      class="bg-card border-borderCard p-8 rounded-xl border shadow-[0_0_25px_var(--tertiary)]"
    >
      
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Welcome again!</h1>
        <p class="text-specialText">Sign in to manage your posts.</p>
      </div>

      
      <form action="/signin" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <div>
          <label for="email" class="block font-bold text-specialText mb-1.5 ml-1">
            E-mail
          </label>
          <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-specialText group-focus-within:text-accent transition-colors">
              {{> icons/email}}
            </div>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="your@email.com"
              class="w-full pl-11 pr-4 py-3 bg-transparent border border-borderCard rounded-sm placeholder-specialText focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all"
            />
          </div>
        </div>

        <div>
          
          <label for="password" class="block font-bold text-specialText">
            Password
          </label>
          
          <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-specialText group-focus-within:text-accent transition-colors">
              {{> icons/lock}}
            </div>
            <input
              id="password"
              type="password"
              name="password"
              placeholder="type your password"
              class="w-full pl-11 pr-12 py-3 bg-transparent border border-borderCard rounded-sm placeholder-specialText focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all"
            />
            <button
              type="button"
              onclick={togglePassword()}
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-specialText hover:text-white"
            >
              {{> icons/eye}}
            </button>
          </div>
        </div>

        <button
          type="submit"
          class="w-full bg-primary flex items-center justify-center gap-2 py-3.5 rounded-sm font-bold  hover:bg-accent"
        >
          Sign In
          {{> icons/chevronRight}}
        </button>
      </form>

      <p class="mt-8 text-center text-specialText">
        Don’t have an account?
        <a href="/register" class="text-accent font-semibold hover:underline">
          Sign up.
        </a>
      </p>
    </div>
  </div>
</div>

<script>
  function togglePassword() {
    const input = document.getElementById('password');
    input.type = input.type === 'password' ? 'text' : 'password';
  }
</script>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.5s ease-out forwards;
  }
</style>