
<div class="w-full max-w-2xl mx-auto py-2 px-6">

  <div class="flex items-center gap-4 mb-8">
    <a 
      href="/dashboard"
      class="p-2 rounded-lg bg-background2 border border-border text-specialText hover:text-white"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold">
        Edit Post 
      </h1>
      <p class="text-specialText text-sm">
        Update your post 
      </p>
    </div>
  </div>

  <div class="p-8 rounded-2xl border border-borderCard bg-background2 shadow-xl">
    <form 
      action="/update-post" 
      method="POST" 
      class="space-y-6"
    >
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <input type="hidden" name="post_id" value="{{post.id}}">

      <div>
        <label for="text" class="flex text-sm font-medium text-specialText mb-3  items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#0e4EB2]"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Your Post
        </label>
        
        <textarea
          name="text"
          id="text"
          placeholder="Type your post here..."
          class="w-full h-48 p-4 bg-background border border-primary rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-accent/20 focus:border-accent transition-all text-lg leading-relaxed"
          maxlength="150"
        >{{post.text}}</textarea>
      </div>

      <div class="flex gap-4 pt-4">
        <a
          href="/dashboard"
          class="flex-1 py-3.5 rounded-lg font-bold text-center text-specialText bg-transparent border border-border hover:bg-redColor hover:text-white"
        >
          Cancel
        </a>
        <button
          type="submit"
          class="bg-primary flex-2 flex items-center justify-center gap-2 py-3.5 rounded-lg font-bold hover:bg-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Save Changes 
        </button>
      </div>
    </form>
  </div>
</div>
